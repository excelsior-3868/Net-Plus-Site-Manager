rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      let uid = request.auth.uid;
      return exists(/databases/$(database)/documents/users/$(uid)) && 
             get(/databases/$(database)/documents/users/$(uid)).data.role == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^(nimrp01@gmail\\.com|dephawa363@gmail\\.com|jackchang987@gmail\\.com|jackchang009@gmail\\.com)$') || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'))
      );
    }

    function isEditor() {
      return isAdmin() || hasRole('editor');
    }

    function isViewer() {
      return isEditor() || hasRole('viewer');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Site Validation
    function isValidSite(data) {
      return data.siteId is string && data.siteId.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.status in ['Active', 'Inactive', 'Maintenance', 'Decommissioned', 'Planned', 'Surveyed'] &&
             data.admin is map &&
             data.technologies is map &&
             data.tower is map &&
             data.power is map &&
             data.transmission is map &&
             data.owner is map &&
             data.leaseContract is map &&
             data.engineer is map &&
             data.environment is map;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['superadmin', 'admin', 'editor', 'viewer'];
    }

    function isValidComplaint(data) {
      return data.ticketNumber is string && data.ticketNumber.size() <= 64 &&
             data.complaintName is string && data.complaintName.size() <= 256 &&
             data.status in ['Open', 'Resolved', 'In Progress'];
    }

    // Match Rules
    match /sites/{siteId} {
      allow list: if isSignedIn() && isViewer();
      allow get: if isSignedIn() && isViewer() && isValidId(siteId);
      
      allow create: if isSignedIn() && isEditor() && (isAdmin() || (
                    isValidSite(incoming()) && 
                    incoming().createdAt == request.time));
      
      allow update: if isSignedIn() && isEditor() && (isAdmin() || (
                    isValidSite(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().createdAt == existing().createdAt));
      
      allow delete: if isSignedIn() && isAdmin();
    }

    match /complaints/{complaintId} {
      allow list: if isSignedIn() && isViewer();
      allow get: if isSignedIn() && isViewer() && isValidId(complaintId);
      
      allow create: if isSignedIn() && isEditor() && (isAdmin() || (
                    isValidComplaint(incoming()) && 
                    incoming().createdAt == request.time));
      
      allow update: if isSignedIn() && isEditor() && (isAdmin() || (
                    isValidComplaint(incoming()) &&
                    incoming().updatedAt == request.time));
      
      allow delete: if isSignedIn() && isAdmin();
    }

    match /users/{userId} {
      allow get: if true; // Allow reading profiles for bootstrap/checks
      allow list: if isSignedIn() && isAdmin();
      
      allow create: if isSignedIn() && (
        (isAdmin() && isValidUser(incoming())) ||
        (request.auth.uid == userId && incoming().role == 'viewer')
      );
      
      allow update: if isSignedIn() && (isAdmin() || (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email'])));
      allow delete: if isSignedIn() && isAdmin();
    }

    // Connection testing
    match /test/connection {
      allow get: if true;
    }
  }
}
